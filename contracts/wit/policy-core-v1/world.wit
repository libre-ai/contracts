package libre-ai:policy-core@1.0.0;

interface types {
  record contract-error {
    code: string,
    message: string,
  }
}

world policy-core {
  use types.{contract-error};

  /// Evaluates policy-definition.v1, model-snapshot.v1 and policy-need.v1 JSON bytes.
  /// SEMANTICS.md is normative for validation, operators, freshness, ordering and hashes.
  /// Current time is explicit input and no host capability is imported.
  export evaluate: func(policy: list<u8>, snapshot: list<u8>, need: list<u8>, evaluated-at: string) -> result<list<u8>, contract-error>;
}
