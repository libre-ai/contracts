{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/model-snapshot.v1.schema.json",
  "title": "Libre AI Model Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tenantId", "modelId", "capturedAt", "facts", "digest"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.model-snapshot.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "modelId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "capturedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "source"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
          "value": {
            "oneOf": [
              { "type": "string", "maxLength": 5000 },
              { "type": "number" },
              { "type": "boolean" },
              {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
                }
              }
            ]
          },
          "source": { "$ref": "common.v1.schema.json#/$defs/sourceReference" }
        }
      }
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
  }
}
