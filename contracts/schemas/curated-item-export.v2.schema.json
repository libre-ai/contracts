{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/curated-item-export.v2.schema.json",
  "title": "Libre AI Curated Item Export v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "exportedAt", "items"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.curated-item-export.v2" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "exportedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "sourceUrl",
          "title",
          "normalizedDigest",
          "decision",
          "ruleSetId",
          "ruleSetVersion",
          "decidedAt"
        ],
        "properties": {
          "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
          "sourceId": { "$ref": "common.v1.schema.json#/$defs/urn" },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "normalizedDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
          "decision": { "enum": ["retain", "reject"] },
          "ruleSetId": { "$ref": "common.v1.schema.json#/$defs/urn" },
          "ruleSetVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "decidedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
        }
      }
    }
  }
}
