{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/policy-definition.v1.schema.json",
  "title": "Libre AI Policy Definition v1",
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact", "operator", "value", "unknown", "source"],
      "properties": {
        "id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "fact": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
        "operator": { "enum": ["equals", "not-equals", "in", "not-in", "at-least", "at-most"] },
        "value": {
          "oneOf": [
            { "type": "string", "maxLength": 5000 },
            { "type": "number" },
            { "type": "boolean" },
            {
              "type": "array",
              "maxItems": 100,
              "items": {
                "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
              }
            }
          ]
        },
        "unknown": { "enum": ["indeterminate", "ineligible"] },
        "source": { "$ref": "common.v1.schema.json#/$defs/sourceReference" },
        "maxSourceAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "version",
    "status",
    "rules",
    "digest",
    "approvedAt",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.policy-definition.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "tenantId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "const": "approved" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rule" }
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "approvedAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "approval": { "$ref": "common.v1.schema.json#/$defs/approvalReference" }
  }
}
