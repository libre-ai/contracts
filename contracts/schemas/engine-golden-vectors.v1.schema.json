{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/engine-golden-vectors.v1.schema.json",
  "title": "Libre AI Specialized Engine Golden Vector Index v1",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 20,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^libre-ai\\.[a-z][a-z0-9.-]*golden[a-z0-9.-]*\\.v[0-9]+$",
      "maxLength": 128
    },
    "world": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$", "maxLength": 128 },
    "status": { "$ref": "#/$defs/shortPublicString" },
    "semantics": { "$ref": "#/$defs/contractPath" },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 64
    },
    "digestAlgorithm": { "$ref": "#/$defs/shortPublicString" },
    "canonicalization": { "$ref": "#/$defs/shortPublicString" },
    "testMaterialWarning": {
      "allOf": [{ "$ref": "#/$defs/publicString" }, { "type": "string", "maxLength": 1000 }]
    },
    "contractFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractFile" }
    },
    "parseCases": { "$ref": "#/$defs/vectorList" },
    "evaluationCases": { "$ref": "#/$defs/vectorList" },
    "cases": { "$ref": "#/$defs/vectorList" },
    "vectors": { "$ref": "#/$defs/vectorList" },
    "aggregationVectors": { "$ref": "#/$defs/vectorList" },
    "invalidPolicyVectors": { "$ref": "#/$defs/vectorList" },
    "golden": { "$ref": "#/$defs/publicValue" },
    "mutations": { "$ref": "#/$defs/vectorList" },
    "standards": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/publicString" }
    },
    "reproductionEvidence": { "$ref": "#/$defs/publicValue" },
    "contextCanonicalization": { "$ref": "#/$defs/publicValue" },
    "recoverySecretCodeProfile": { "$ref": "#/$defs/publicValue" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "libre-ai.engine-golden-vectors.v1" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["world", "status", "cases"],
        "properties": {
          "world": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$",
            "maxLength": 128
          },
          "status": { "$ref": "#/$defs/shortPublicString" },
          "cases": { "$ref": "#/$defs/vectorList" }
        }
      }
    }
  ],
  "$defs": {
    "shortPublicString": {
      "allOf": [{ "$ref": "#/$defs/publicString" }, { "type": "string", "maxLength": 128 }]
    },
    "publicString": {
      "type": "string",
      "maxLength": 65536,
      "allOf": [
        {
          "not": {
            "pattern": "[\\s\\S]*(?:sk_live_[A-Za-z0-9_-]{8,}|sk-(?:proj|svcacct)-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----)[\\s\\S]*"
          }
        },
        {
          "anyOf": [
            { "not": { "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}" } },
            {
              "pattern": "^https://user:secret@example\\.org(?:[/?#]|$)"
            }
          ]
        }
      ]
    },
    "contractPath": {
      "type": "string",
      "minLength": 11,
      "maxLength": 512,
      "pattern": "^contracts/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*))*$"
    },
    "contractFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/contractPath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "vectorList": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/publicValue" }
    },
    "publicValue": {
      "$comment": "libre-ai-static-projection-recursion=opaque",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "$ref": "#/$defs/publicString" },
        {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/publicValue" }
        },
        {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": { "minLength": 1, "maxLength": 128 },
          "additionalProperties": { "$ref": "#/$defs/publicValue" }
        }
      ]
    }
  }
}
