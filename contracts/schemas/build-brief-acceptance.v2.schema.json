{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/build-brief-acceptance.v2.schema.json",
  "title": "Libre AI build-brief-acceptance v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "statement", "signature"],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.build-brief-acceptance.v2"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "tenantId",
        "specPackageId",
        "specPackageVersion",
        "subjectDigest",
        "approverId",
        "role",
        "acceptedAt",
        "membershipRevision",
        "policyDigest",
        "signingKeyId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "libre-ai.build-brief-acceptance-statement.v2"
        },
        "id": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "tenantId": {
          "$ref": "common.v1.schema.json#/$defs/tenantId"
        },
        "specPackageId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "specPackageVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "subjectDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "approverId": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "role": {
          "const": "build-brief-approver"
        },
        "acceptedAt": {
          "$ref": "common.v1.schema.json#/$defs/timestamp"
        },
        "membershipRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policyDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "signingKeyId": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "minLength": 86,
      "maxLength": 86
    }
  }
}
