{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/spec-package.v2.schema.json",
  "title": "Libre AI spec-package v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "body", "bodyDigest", "acceptances"],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.spec-package.v2"
    },
    "body": {
      "$ref": "build-brief-body.v2.schema.json"
    },
    "bodyDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "acceptances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "build-brief-acceptance.v2.schema.json"
      }
    }
  }
}
